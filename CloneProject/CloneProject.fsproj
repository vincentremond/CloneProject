<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <WarningsAsErrors>FS0025</WarningsAsErrors>
    <ApplicationIcon>CloneProject.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Targets*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="paket.references" />
    <None Include="CloneProject.ico" />
    <Compile Include="Process.fs" />
    <Compile Include="Configuration.fs" />
    <Compile Include="ConfigurationLocator.fs" />
    <Compile Include="ConfigurationReader.fs" />
    <Compile Include="GitUrlFixer.fs" />
    <Compile Include="TargetDirectoryService.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>
  <Import Project="..\.paket\Paket.Restore.targets" />
</Project>